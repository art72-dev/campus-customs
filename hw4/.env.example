# Copy this file to .env (in this hw4/ folder) and fill in real values.
# Never commit .env or share these values.

# Portkey key for the AI assistant (gpt-5.6-luna through the Portkey gateway)
PORTKEY_API_KEY=your-portkey-api-key-here

# Signs login session cookies. Any long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: only if you use a Portkey gateway other than the default
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
